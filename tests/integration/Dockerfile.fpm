FROM php:8.2-fpm-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends nginx libsqlite3-dev libicu-dev libonig-dev libavif-dev libwebp-dev libjpeg62-turbo-dev libpng-dev \
    && docker-php-ext-configure gd --with-jpeg --with-webp --with-avif \
    && docker-php-ext-install gd pdo_sqlite exif intl mbstring \
    && rm -rf /var/lib/apt/lists/*
COPY . /var/www/html
RUN ln -s storage/.env /var/www/html/.env \
    && chown -R www-data:www-data /var/www/html \
    && printf 'server { listen 80; root /var/www/html/public; index index.php; location / { try_files $uri /index.php?$query_string; } location ~ \\.php$ { include fastcgi_params; fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name; fastcgi_pass 127.0.0.1:9000; } }\n' > /etc/nginx/sites-enabled/default
CMD ["sh", "-c", "nginx && exec php-fpm -F"]
