    </header>

    <!-- Dark mode toggle wiring: flips the `dark` class on <html> and persists the
         visitor's choice to localStorage (overrides the admin site default). The
         pre-paint script in <head> applies the stored choice on subsequent loads. -->
    <script nonce="{{ csp_nonce() }}">
    (function(){
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        var root = document.documentElement;
        var labels = { dark: '{{ trans('theme.toggle_dark')|e('js') }}', light: '{{ trans('theme.toggle_light')|e('js') }}' };
        // Icon visibility is driven by the html.dark CSS rules above; sync only
        // updates the accessible state (aria-pressed/aria-label) on theme change.
        function sync(){
            var isDark = root.classList.contains('dark');
            btn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
            // Label reflects the action the button performs next.
            btn.setAttribute('aria-label', isDark ? labels.light : labels.dark);
        }
        sync();
        btn.addEventListener('click', function(){
            var isDark = root.classList.toggle('dark');
            try { localStorage.setItem('cimaise-theme', isDark ? 'dark' : 'light'); } catch(e){}
            sync();
        });
    })();
    </script>

    <!-- Main content -->
    <main id="main-content">
        {% block content %}{% endblock %}
    </main>

    <!-- Footer -->
    <footer class="border-t border-neutral-200 mt-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div class="flex flex-col md:flex-row justify-between items-center">
                <div class="text-sm text-neutral-600 flex items-center flex-wrap gap-3">
                    <span>{{ site_copyright|replace_year }}</span>
                    {% if license_show_in_footer|default(false) %}
                    <span class="text-neutral-300">|</span>
                    <a href="{{ license_url|default(base_path ~ '/license') }}" class="inline-block py-2 hover:text-black transition-colors">{{ license_title_footer|default(trans('nav.license')) }}</a>
                    {% endif %}
                    {% if privacy_show_in_footer|default(false) %}
                    <span class="text-neutral-300">|</span>
                    <a href="{{ privacy_url|default(base_path ~ '/privacy-policy') }}" class="inline-block py-2 hover:text-black transition-colors">{{ privacy_title_footer|default(trans('nav.privacy')) }}</a>
                    {% endif %}
                    {% if cookie_show_in_footer|default(false) %}
                    <span class="text-neutral-300">|</span>
                    <a href="{{ cookie_url|default(base_path ~ '/cookie-policy') }}" class="inline-block py-2 hover:text-black transition-colors">{{ cookie_title_footer|default(trans('nav.cookie')) }}</a>
                    {% endif %}
