                        <div class="header-search-actions">
                            <button type="button" id="header-search-clear" class="header-search-clear hidden" aria-label="{{ trans('filter.clear_filters') }}">
                                <i class="fas fa-times text-[11px]"></i>
                            </button>
                            <button type="submit" class="header-search-submit" aria-label="{{ trans('filter.search') }}">
                                <i class="fas fa-arrow-right text-sm"></i>
                            </button>
                        </div>
                    </div>
