                </div>

                <!-- Mobile Tags -->
                {% if show_tags_in_header and nav_tags|default([])|length > 0 %}
                <div class="border-t border-gray-200 pt-4">
                    <div class="text-xs uppercase tracking-wider text-gray-500 font-semibold mb-2 px-3">{{ trans('nav.tags') }}</div>
                    <div class="flex flex-wrap gap-2 px-3">
                        {% for tag in nav_tags %}
                        <a href="{{ base_path }}/tag/{{ tag.slug }}" class="inline-flex items-center gap-1.5 text-sm px-3 py-1.5 rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200 hover:text-black transition-colors duration-200">
                            <span>{{ tag.name|e }}</span>
                            <span class="text-xs text-gray-400">({{ tag.albums_count }})</span>
                        </a>
                        {% endfor %}
                    </div>
