        </div>
    </footer>

    <!-- PhotoSwipe lightbox (local) loaded dynamically in JS -->
    
    {# Vendor scripts loaded conditionally, per library:
       - needs_vendor_scripts = false  → master kill-switch, skips ALL vendor JS (backward compatible)
       - needs_swiper  (default false) → opt IN on templates with carousels (e.g. gallery_hero)
       - needs_gsap    (default true)  → the layout's own album-card/gallery entry animations and
                                          header hide/show use GSAP on most content pages; opt OUT
                                          only on pages that provably render no animated elements
       - needs_masonry (default false) → opt IN on album/gallery templates that run the Masonry
                                          runtime (imagesLoaded travels with Masonry) #}
    {# NOTE: `is defined ? x : y` instead of `|default(y)` — Twig's default filter
       treats an explicit `false` as empty and would return the default. #}
    {% set _vendor_scripts_enabled = needs_vendor_scripts is defined ? needs_vendor_scripts : true %}
    {% if _vendor_scripts_enabled and (needs_swiper is defined ? needs_swiper : false) %}
    <!-- Swiper.js - Deferred for better initial load performance -->
    <script nonce="{{ csp_nonce() }}" src="{{ base_path }}/assets/vendor/swiper/swiper-bundle.min.js" defer></script>
    {% endif %}

    {% if _vendor_scripts_enabled and (needs_gsap is defined ? needs_gsap : true) %}
    <!-- GSAP - Deferred (progressive enhancement for animations) -->
    <script nonce="{{ csp_nonce() }}" src="{{ base_path }}/assets/vendor/gsap/gsap.min.js" defer></script>
    <script nonce="{{ csp_nonce() }}" src="{{ base_path }}/assets/vendor/gsap/ScrollTrigger.min.js" defer></script>
    {% endif %}

    {% if _vendor_scripts_enabled and (needs_masonry is defined ? needs_masonry : false) %}
    <!-- imagesLoaded + Masonry - Deferred -->
    <script nonce="{{ csp_nonce() }}" src="{{ base_path }}/assets/vendor/imagesloaded/imagesloaded.pkgd.min.js" defer></script>
    <script nonce="{{ csp_nonce() }}" src="{{ base_path }}/assets/vendor/masonry/masonry.pkgd.min.js" defer></script>
    {% endif %}
    
    <!-- App JS -->
    <script nonce="{{ csp_nonce() }}">
        window.CimaiseLayout = {
            basePath: {{ base_path|default('')|json_encode|raw }},
            allowDownloads: {{ allow_downloads|default(false) ? 'true' : 'false' }},
            i18n: {{ {
                exifTitle: trans('lightbox.exif_title')|default('Image Details'),
                loading: trans('lightbox.loading')|default('Loading...'),
                infoButton: trans('lightbox.info_button')|default('Image Info'),
                noExif: trans('lightbox.no_exif')|default('No EXIF data available'),
                viewMap: trans('lightbox.view_map')|default('View on map'),
                exifError: trans('lightbox.exif_error')|default('Failed to load EXIF data'),
                download: trans('image.download'),
                close: trans('general.close'),
                previous: trans('general.previous'),
                next: trans('general.next')
            }|json_encode|raw }}
        };
    </script>
    <script nonce="{{ csp_nonce() }}" src="{{ base_path }}/assets/js/frontend-layout.js?v={{ app_version|default('0')|e('url') }}"></script>

    <!-- Smooth Scroll (Lenis) - Deferred (progressive enhancement) -->
    <script nonce="{{ csp_nonce() }}" type="module" src="{{ vite_asset('js/smooth-scroll.js') }}"></script>

    <!-- Analytics Tracking (Cookieless) - Deferred (not critical for initial render) -->
    <script nonce="{{ csp_nonce() }}" src="{{ base_path }}/assets/js/analytics.js" defer></script>
    <script nonce="{{ csp_nonce() }}">
        // Initialize analytics with site configuration
        // Enable by default; JS guard will self-disable if endpoint fails
        window.CimaiseAnalyticsEnabled = true;
        window.CimaiseAnalyticsConfig = {
            endpoint: '{{ base_path }}/api/analytics/track',
            debug: {{ app_debug|default(false) ? 'true' : 'false' }}
        };
        window.nsfwConsent = {{ nsfw_consent|default(false) ? 'true' : 'false' }};
        window.isAdmin = {{ is_admin|default(false) ? 'true' : 'false' }};
        window.allowDownloads = {{ allow_downloads|default(false) ? 'true' : 'false' }};

        function safeLocalStorageGet(key) {
            try {
                return window.localStorage ? window.localStorage.getItem(key) : null;
            } catch (e) {
                return null;
            }
        }

        window.applyNsfwConsentState = function() {
            // N5: the SERVER is the source of truth. The signed consent cookie
            // expires after 30 days but localStorage never does, so trusting
            // localStorage alone made cover swaps fire while the server kept
            // serving blur bytes — leaving covers blurred with no overlay and no
            // way back to the gate. Only reveal when the server actually grants
            // consent (window.nsfwConsent) or the viewer is an admin.
            const canShow = window.isAdmin || window.nsfwConsent === true;
            if (!canShow) return;

            document.documentElement.classList.add('nsfw-confirmed');
            document.body.classList.add('nsfw-confirmed');

            document.querySelectorAll('img[data-nsfw-real-src]').forEach(function(img) {
                const realSrc = img.getAttribute('data-nsfw-real-src');
                if (realSrc && img.getAttribute('data-nsfw-swapped') !== '1') {
                    img.setAttribute('data-nsfw-swapped', '1');
                    img.src = realSrc;
                }
                img.classList.remove('nsfw-blur');
            });
        };

        document.addEventListener('DOMContentLoaded', function() {
            window.applyNsfwConsentState();
        });
        window.addEventListener('storage', function() {
            window.applyNsfwConsentState();
        });
        
        // Add meta tags for analytics
        {% if current_album %}
        window.albumId = {{ current_album.id }};
        {% endif %}
        {% if current_category %}
        window.categoryId = {{ current_category.id }};
        {% endif %}
        {% if current_tag %}
        window.tagId = {{ current_tag.id }};
        {% endif %}
    </script>

    {% include 'frontend/_download_runtime.twig' %}
    {% include 'frontend/_pwa_runtime.twig' %}

    {% if page_custom_js is defined and page_custom_js %}
    {{ page_custom_js|raw }}
    {% endif %}

    {% block scripts %}{% endblock %}

    {% if template_custom_js is defined and template_custom_js %}
    {{ template_custom_js|raw }}
    {% endif %}

    {# Essential JavaScript - Always loaded (no consent required) #}
    {% if custom_js_essential %}
    <script id="custom-js-essential" nonce="{{ csp_nonce() }}">{{ custom_js_essential|raw }}</script>
    {% endif %}

    {# Block right-click on images for non-admin users #}
    {# `?? true` (not `|default(true)`): Twig's default filter also replaces FALSE,
       which silently re-enabled the blocker after the admin turned it off. #}
    {% if not is_admin and ((disable_right_click ?? true) or not (allow_downloads ?? false)) %}
    <style nonce="{{ csp_nonce() }}">img, picture { -webkit-touch-callout: none; -webkit-user-select: none; user-select: none; } img { -webkit-user-drag: none; }</style>
    {% endif %}
    {% if (disable_right_click ?? true) and not is_admin %}
    <script nonce="{{ csp_nonce() }}">
    document.addEventListener('contextmenu', function(e) {
      const target = e.target;
      // Block context menu on images, pictures, and common image containers
      if (target && (target.tagName === 'IMG' || target.closest('picture, .image-item, .album-card, .gallery-card, .inf-work_item'))) {
        e.preventDefault();
      }
    }, { passive: false });
    </script>
    {% endif %}


    {% include 'frontend/_analytics_tags.twig' %}

    {# Cookie Banner with conditional script loader #}
    {% include 'partials/cookie-banner.twig' %}

    {# Global NSFW Warning Gate #}
    {% include 'frontend/_nsfw_global_gate.twig' %}
</body>
</html>
