                            <option value="hybrid">{{ trans('filter.hybrid') }}</option>
                        </select>
                    </div>

                    <div class="flex items-center gap-3">
                        <label for="layout-filter-sort" class="text-sm font-medium text-gray-700">{{ trans('filter.sort') }}:</label>
                        <select id="layout-filter-sort" class="border border-gray-300 rounded-md px-3 py-1.5 text-sm bg-white shadow-sm focus:border-gray-500 focus:ring-1 focus:ring-gray-500 transition-colors">
                            <option value="published_desc">{{ trans('filter.latest') }}</option>
                            <option value="published_asc">{{ trans('filter.oldest') }}</option>
