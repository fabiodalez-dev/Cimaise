                {% endif %}

            </div>
        </div>

        <!-- Enhanced Filters Panel -->
        <div id="filters-panel" class="border-t border-gray-200 bg-gray-50/80 backdrop-blur-md hidden transition-all duration-300">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
                <div class="flex flex-wrap gap-4 items-center">
                    <div class="flex items-center gap-3">
                        <label for="filter-process" class="text-sm font-medium text-gray-700">{{ trans('filter.process') }}:</label>
