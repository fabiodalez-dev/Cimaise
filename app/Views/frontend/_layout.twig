<!DOCTYPE html>
<html lang="{{ site_language|default(lang|default('en'))|e('html_attr') }}" class="no-js{% if dark_mode|default(false) %} dark{% endif %}">
<head>
    <!-- JS flag class on <html> for no-JS fallbacks + visitor theme (runs before paint to avoid FOUC) -->
    <script nonce="{{ csp_nonce() }}">(function(){ var d=document.documentElement; d.classList.remove('no-js'); d.classList.add('js'); window.basePath = '{{ base_path|e("js") }}'; window.__showExifInLightbox = {{ lightbox_show_exif ? 'true' : 'false' }}; var allow={{ (allow_theme_toggle ?? true) ? 'true' : 'false' }}; if(allow){ try{ var t=localStorage.getItem('cimaise-theme'); if(t==='dark'){d.classList.add('dark');} else if(t==='light'){d.classList.remove('dark');} }catch(e){} } })();</script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page_title|default(site_title|default('Cimaise'))|e }}</title>

    {% if meta_description %}
    <meta name="description" content="{{ meta_description|e('html_attr') }}">
    {% endif %}
    {% if site_keywords|default('') %}
    <meta name="keywords" content="{{ site_keywords|e('html_attr') }}">
    {% endif %}

    <!-- Favicon & App Icons -->
    {# FaviconService writes /favicon.ico as a PNG (GD imagepng, .ico extension for
       legacy compatibility), so declare the accurate MIME to satisfy validators. #}
    <link rel="icon" type="image/png" href="{{ base_path }}/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ base_path }}/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ base_path }}/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ base_path }}/apple-touch-icon.png">

    <!-- PWA Manifest & Meta Tags -->
    <link rel="manifest" href="{{ base_path }}/site.webmanifest">
    <link rel="alternate" type="application/rss+xml" title="{{ site_title|default('Cimaise') }} — RSS" href="{{ base_path }}/feed.xml">
    <link rel="alternate" type="application/atom+xml" title="{{ site_title|default('Cimaise') }} — Atom" href="{{ base_path }}/feed/atom">
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f5f5">
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Cimaise">
    <meta name="mobile-web-app-capable" content="yes">

    <!-- Resource Hints for Performance -->
    {% set hints = resource_hints() %}
    {% for hint in hints['dns-prefetch'] %}
    <link rel="dns-prefetch" href="{{ hint.href }}">
    {% endfor %}
    {% for hint in hints['preconnect'] %}
    {% if hint.href %}
    <link rel="preconnect" href="{{ hint.href }}"{% if hint.crossorigin %} crossorigin{% endif %}>
    {% endif %}
    {% endfor %}

    <!-- Preload Critical Resources -->
    <link rel="preload" href="{{ base_path }}/fonts/typography.css?v={{ typography_version|default(app_version) }}" as="style">
    <link rel="preload" href="{{ vite_asset('app.css') }}" as="style">
    <link rel="preload" href="{{ vite_asset('frontend.css') }}" as="style">

    <!-- Preload Critical Fonts (user-selected) to prevent FOUT -->
    {% if critical_fonts_preload is defined and critical_fonts_preload|length > 0 %}
        {% for font in critical_fonts_preload %}
    <link rel="preload" href="{{ font.url }}" as="font" type="{{ font.mime|default('font/woff2') }}" crossorigin>
        {% endfor %}
    {% endif %}

    <!-- Open Graph -->
    <meta property="og:title" content="{{ page_title|e('html_attr') }}">
    {% if meta_description %}
    <meta property="og:description" content="{{ meta_description|e('html_attr') }}">
    {% endif %}
    {% if meta_image %}
    <meta property="og:image" content="{{ meta_image|e('html_attr') }}">
    {% if meta_image_width is defined and meta_image_width and meta_image_height is defined and meta_image_height %}
    <meta property="og:image:width" content="{{ meta_image_width|e('html_attr') }}">
    <meta property="og:image:height" content="{{ meta_image_height|e('html_attr') }}">
    {% endif %}
    <meta property="og:image:alt" content="{{ meta_image_alt|default(album.title|default(page_title))|e('html_attr') }}">
    {% endif %}
    <meta property="og:type" content="{{ og_type|default('website')|e('html_attr') }}">
    <meta property="og:url" content="{{ canonical_url|default(current_url)|e('html_attr') }}">
    {% if og_locale %}<meta property="og:locale" content="{{ og_locale|e('html_attr') }}">{% endif %}
    <meta property="og:site_name" content="{{ og_site_name|default(site_title)|default('Portfolio')|e('html_attr') }}">

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="{{ twitter_card|default('summary_large_image')|e('html_attr') }}">
    <meta name="twitter:title" content="{{ page_title|e('html_attr') }}">
    {% if meta_description %}<meta name="twitter:description" content="{{ meta_description|e('html_attr') }}">{% endif %}
    {% if meta_image %}
    <meta name="twitter:image" content="{{ meta_image|e('html_attr') }}">
    <meta name="twitter:image:alt" content="{{ page_title|e('html_attr') }}">
    {% endif %}
    {% if twitter_site %}<meta name="twitter:site" content="{{ twitter_site|e('html_attr') }}">{% endif %}
    {% if twitter_creator %}<meta name="twitter:creator" content="{{ twitter_creator|e('html_attr') }}">{% endif %}

    <!-- Canonical & Robots -->
    {% if canonical_url %}<link rel="canonical" href="{{ canonical_url|e('html_attr') }}">{% endif %}
    <meta name="robots" content="{{ robots|default('index,follow,max-image-preview:large')|e('html_attr') }}">

    {# Search engine site verification (optional) #}
    {% if google_verification|default('') %}<meta name="google-site-verification" content="{{ google_verification|e('html_attr') }}">{% endif %}
    {% if bing_verification|default('') %}<meta name="msvalidate.01" content="{{ bing_verification|e('html_attr') }}">{% endif %}

    {# Organization/Person JSON-LD from SEO settings (if provided).
       Built as a Twig map + json_encode so the @id is a STABLE site identity
       (canonical_base ~ '/#person' | '/#organization') rather than the current
       page URL — the same node is referenced from every page. #}
    {% if schema is defined and (schema.author_name or schema.organization_name) %}
      {% set _cbase = schema.canonical_base|default(canonical_base|default('')) %}
      {% if schema.author_name %}
        {% set _entity = { '@context': 'https://schema.org', '@type': 'Person', '@id': _cbase ~ '/#person', 'name': schema.author_name } %}
        {% if schema.author_url %}{% set _entity = _entity|merge({ 'url': schema.author_url }) %}{% endif %}
        {% if meta_image %}{% set _entity = _entity|merge({ 'image': meta_image }) %}{% endif %}
        {% set _entity = _entity|merge({ 'jobTitle': schema.photographer_job_title|default('Photographer') }) %}
        {% if schema.photographer_area_served|default('') %}{% set _entity = _entity|merge({ 'areaServed': schema.photographer_area_served }) %}{% endif %}
        {% set _bio = photographer_bio|default('') %}
        {% if _bio %}{% set _entity = _entity|merge({ 'description': _bio }) %}{% endif %}
        {% set same_as_raw = schema.photographer_same_as|default('') %}
        {% set same_as_list = [] %}
        {% if same_as_raw %}
          {% for u in same_as_raw|split(',') %}
            {% set t = u|trim %}
            {% if t %}{% set same_as_list = same_as_list|merge([t]) %}{% endif %}
          {% endfor %}
        {% endif %}
        {% if same_as_list %}{% set _entity = _entity|merge({ 'sameAs': same_as_list }) %}{% endif %}
      {% else %}
        {% set _entity = { '@context': 'https://schema.org', '@type': 'Organization', '@id': _cbase ~ '/#organization', 'name': schema.organization_name } %}
        {% if schema.organization_url %}{% set _entity = _entity|merge({ 'url': schema.organization_url }) %}{% endif %}
        {% if schema.photographer_area_served|default('') %}{% set _entity = _entity|merge({ 'areaServed': schema.photographer_area_served }) %}{% endif %}
        {% set _logo_raw = site_logo|default('') %}
        {% if _logo_raw %}
          {% if _logo_raw starts with 'http' %}
            {% set _logo_abs = _logo_raw %}
          {% else %}
            {# _cbase (schema.canonical_base) already includes base_path; the logo
               path is app-root-relative, so DON'T re-add base_path (that doubled
               the subdirectory in subfolder installs). #}
            {% set _logo_abs = _cbase ~ (_logo_raw starts with '/' ? _logo_raw : '/' ~ _logo_raw) %}
          {% endif %}
          {% set _entity = _entity|merge({ 'logo': _logo_abs }) %}
        {% endif %}
      {% endif %}
    <script type="application/ld+json" nonce="{{ csp_nonce() }}">{{ _entity|json_encode|raw }}</script>
    {% endif %}

    {# BreadcrumbList JSON-LD is emitted once by frontend/_breadcrumbs.twig (which
       every breadcrumb-bearing page includes and which builds ABSOLUTE item URLs
       from canonical_base). The old array-driven block here duplicated it AND
       built RELATIVE item URLs (base_path, empty on root installs), so it was
       removed to avoid two BreadcrumbList blocks per page. #}

    {# LocalBusiness Schema (if enabled) #}
    {% if schema is defined and schema.local_business_enabled %}
    <script type="application/ld+json" nonce="{{ csp_nonce() }}">
    {
      "@context": "https://schema.org",
      "@type": {{ schema.local_business_type|default('ProfessionalService')|json_encode|raw }},
      "name": {{ schema.local_business_name|json_encode|raw }},
      {% if schema.local_business_address %}
      "address": {
        "@type": "PostalAddress",
        "streetAddress": {{ schema.local_business_address|json_encode|raw }}
        {% if schema.local_business_city %},"addressLocality": {{ schema.local_business_city|json_encode|raw }}{% endif %}
        {% if schema.local_business_postal_code %},"postalCode": {{ schema.local_business_postal_code|json_encode|raw }}{% endif %}
        {% if schema.local_business_country %},"addressCountry": {{ schema.local_business_country|json_encode|raw }}{% endif %}
      },
      {% endif %}
      {% if schema.local_business_phone %}"telephone": {{ schema.local_business_phone|json_encode|raw }},{% endif %}
      {% if schema.local_business_geo_lat and schema.local_business_geo_lng %}
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": {{ schema.local_business_geo_lat|json_encode|raw }},
        "longitude": {{ schema.local_business_geo_lng|json_encode|raw }}
      },
      {% endif %}
      {% if schema.local_business_opening_hours %}"openingHours": {{ schema.local_business_opening_hours|json_encode|raw }},{% endif %}
      "url": {{ (canonical_url|default(current_url))|json_encode|raw }},
      {% if meta_image %}"image": {{ meta_image|json_encode|raw }},{% endif %}
      "priceRange": {{ (schema.local_business_price_range|default('$$'))|json_encode|raw }}
    }
    </script>
    {% endif %}
    
    <!-- Fonts: use system stack to comply with CSP -->

    <!-- CRITICAL CSS - Render blocking (required for initial paint) -->
    <link href="{{ vite_asset('app.css') }}" rel="stylesheet">
    <link rel="stylesheet" href="{{ base_path }}/fonts/typography.css?v={{ typography_version|default(app_version) }}">

    <!-- NON-CRITICAL CSS - Loaded async to avoid render blocking -->
    <!-- PhotoSwipe CSS (only needed when lightbox opens) -->
    <link rel="stylesheet" href="{{ base_path }}/assets/photoswipe/photoswipe.css" media="print" id="photoswipe-css">
    <noscript><link rel="stylesheet" href="{{ base_path }}/assets/photoswipe/photoswipe.css"></noscript>

    {% if (needs_vendor_scripts is defined ? needs_vendor_scripts : true) and (needs_swiper is defined ? needs_swiper : false) %}
    <!-- Swiper CSS (only needed for carousels - opt in with needs_swiper = true) -->
    <link rel="stylesheet" href="{{ base_path }}/assets/vendor/swiper/swiper-bundle.min.css" media="print" id="swiper-css">
    <noscript><link rel="stylesheet" href="{{ base_path }}/assets/vendor/swiper/swiper-bundle.min.css"></noscript>
    {% endif %}

    <!-- Font Awesome (~100KB - defer loading, icons appear after paint) -->
    <link rel="stylesheet" href="{{ base_path }}/assets/vendor/fontawesome/css/frontend-subset.css" media="print" id="fontawesome-css">
    <noscript><link rel="stylesheet" href="{{ base_path }}/assets/vendor/fontawesome/css/frontend-subset.css"></noscript>

    <!-- CSP-compliant async CSS loading (replaces inline onload handlers) -->
    <script nonce="{{ csp_nonce() }}">['photoswipe-css','swiper-css','fontawesome-css'].forEach(function(id){var e=document.getElementById(id);if(e){if(e.sheet){e.media='all';}else{e.onload=function(){this.media='all';};}}});</script>
    
    <!-- Custom styles (Vite-bundled) -->
    <link href="{{ vite_asset('frontend.css') }}" rel="stylesheet">

    <!-- Custom CSS (Frontend Only) -->
    {% if custom_css|default('') is not empty %}
    <style nonce="{{ csp_nonce() }}">
        /* ===== Custom CSS ===== */
        {{ custom_css|raw }}
    </style>
    {% endif %}

    <style nonce="{{ csp_nonce() }}">
        /* Theme toggle icon visibility is driven entirely by the resolved
           <html>.dark state (set pre-paint from localStorage), so the correct
           icon shows on first paint even when the visitor's stored choice
           differs from the server default — and so the FontAwesome `.fas`
           rule (loaded after the `.hidden` utility, same specificity) can't
           override it. The toggle wiring only syncs aria-pressed/aria-label.
           Light: moon (switch-to-dark). Dark: sun (switch-to-light). */
        [data-theme-icon="light"] { display: none !important; }
        [data-theme-icon="dark"] { display: inline-block !important; }
        html.dark [data-theme-icon="dark"] { display: none !important; }
        html.dark [data-theme-icon="light"] { display: inline-block !important; }

        /* Mobile menu scroll lock: while the menu is open, freeze the page
           behind it so only the menu scrolls (and stop scroll-chaining from
           the menu to the body when it reaches its end). */
        html.mobile-menu-open,
        html.mobile-menu-open body { overflow: hidden; }
        #mobile-menu { overscroll-behavior: contain; -webkit-overflow-scrolling: touch; }
    </style>

    {% if page_custom_css is defined and page_custom_css %}
    {{ page_custom_css|raw }}
    {% endif %}

    {% if template_custom_css is defined and template_custom_css %}
    {{ template_custom_css|raw }}
    {% endif %}

    {% block styles %}{% endblock %}
</head>
<body class="min-h-full bg-white text-black font-sans antialiased{% if admin_logged_in|default(false) %} has-admin-bar{% endif %}">
    {# Keyboard/screen-reader users: jump past header + nav straight to content #}
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[10000] focus:bg-white focus:text-black focus:px-4 focus:py-2 focus:rounded-md focus:shadow-lg">{{ trans('nav.skip_to_content', {}, 'Skip to content') }}</a>
    {% include 'frontend/_admin_topbar.twig' %}
    <div id="pswp-open-overlay" aria-hidden="true"></div>

    {# Centralized category filtering logic - used in desktop mega-menu, mobile menu, and JS data #}
    {# A category is visible if it has albums OR has children with albums #}
    {% set filtered_parent_categories = parent_categories|default([])|filter(c => c.albums_count > 0 or c.children|filter(ch => ch.albums_count > 0)|length > 0) %}

    <!-- Header -->
    <header class="border-b border-gray-200 sticky top-0 bg-white/95 backdrop-blur-md z-50" id="main-header">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center py-5">
                <!-- Left: Logo and Desktop Navigation -->
                <div class="flex items-center gap-8">
                    {# div, not h1: the page content provides the single per-page h1;
                       a second h1 in the site header breaks the heading outline #}
                    <div class="text-xl font-semibold">
                        <a href="{{ base_path }}/" class="hover:text-gray-600 transition-colors duration-200 flex items-center gap-3">
                            {% if logo_type == 'image' and site_logo %}
                              {% include 'frontend/_site_logo.twig' with { logo_class: 'h-12 w-auto' } %}
                            {% else %}
                              {{ site_title|default('Portfolio') }}
                            {% endif %}
                        </a>
                    </div>
                    
                    <!-- Desktop Navigation -->
                    <nav class="hidden lg:flex items-center gap-6" id="desktop-nav">
                        <a href="{{ base_path }}/" class="text-sm font-medium hover:text-gray-600 transition-colors duration-200 py-2">{{ trans('nav.home') }}</a>
                        <a href="{{ base_path }}/galleries" class="text-sm font-medium hover:text-gray-600 transition-colors duration-200 py-2">{{ trans('nav.galleries') }}</a>
                        <a href="{% if about_url starts with '/' %}{{ base_path }}{{ about_url }}{% else %}{{ about_url }}{% endif %}" class="text-sm font-medium hover:text-gray-600 transition-colors duration-200 py-2">{{ about_menu_label|default(trans('nav.about'), true)|e }}</a>

                        {{ hook('frontend_nav_after_about', {'base_path': base_path, 'location': 'desktop', 'csp_nonce': csp_nonce()}) }}

                        <!-- Categories Mega Menu -->
                        <div class="static" id="categories-dropdown">
                            <button id="categories-toggle" class="text-sm font-medium inline-flex items-center gap-2 hover:text-gray-600 transition-all duration-200 py-2 px-1 rounded-md" aria-haspopup="true" aria-expanded="false" aria-controls="categories-mega-menu">
                                {{ trans('filter.categories') }}
                                <i class="fas fa-chevron-down text-xs transition-transform duration-200" id="categories-icon"></i>
                            </button>

                            <!-- Mega Menu Panel - fixed positioning to center in viewport -->
                            {# Dynamic width based on category count: responsive from 1 to 5+ columns #}
                            {# Column width ~160px + gap 24px = ~184px per column #}
                            {% set cat_count = filtered_parent_categories|length %}
                            {% set menu_width = cat_count <= 1 ? 'min(90vw, 240px)' : (cat_count == 2 ? 'min(90vw, 420px)' : (cat_count == 3 ? 'min(90vw, 600px)' : (cat_count == 4 ? 'min(90vw, 780px)' : 'min(95vw, 960px)'))) %}
                            <div id="categories-mega-menu" class="fixed left-1/2 top-[80px] -translate-x-1/2 bg-white border border-gray-200 shadow-2xl rounded-2xl z-50 overflow-hidden opacity-0 invisible transform translate-y-2 transition-all duration-300 ease-out" style="width: {{ menu_width }};">
                                <div class="p-6 max-h-[70vh] overflow-y-auto">
                                    <!-- Parent Categories Grid - up to 5 columns on large screens -->
                                    <div class="grid gap-6" id="parent-categories-grid" style="grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); justify-content: center;">
                                        {% for category in filtered_parent_categories %}
                                        <div class="group cursor-pointer category-parent-item relative" data-category-id="{{ category.id }}" data-category-slug="{{ category.slug }}" data-category-name="{{ category.name|e }}">
                                            <a href="{{ base_path }}/category/{{ category.slug }}" class="block hover:no-underline">
                                                <div class="relative aspect-[4/3] overflow-hidden rounded-lg mb-3 bg-gray-50 transition-all duration-300 group-hover:shadow-lg">
                                                    {% if category.image_path and category.image_path != '' %}
                                                        <img src="{{ base_path }}{{ category.image_path }}" alt="{{ category.name|e }}" 
                                                             class="w-full h-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03]"
                                                             data-fallback="hide">
                                                    {% else %}
                                                        <div class="w-full h-full flex items-center justify-center text-gray-400 group-hover:text-gray-600 transition-colors duration-300">
                                                            <i class="fas fa-folder-open text-2xl"></i>
                                                        </div>
                                                    {% endif %}
                                                </div>
                                                
                                                <div class="text-center">
                                                    <h3 class="font-medium text-sm text-gray-900 group-hover:text-black transition-colors duration-200 mb-1">{{ category.name|e }}</h3>
                                                    
                                                    <!-- Subcategories shown as text on hover -->
                                                    {% set visible_children = category.children|filter(ch => ch.albums_count > 0) %}
                                                    {% if visible_children|length > 0 %}
                                                        <div class="subcategories-hover-text opacity-0 group-hover:opacity-100 transition-all duration-300 max-h-0 group-hover:max-h-32 overflow-hidden">
                                                            <div class="text-xs text-gray-600 mt-2 space-y-1">
                                                                {% for child in visible_children|slice(0, 4) %}
                                                                    <div class="hover:text-black transition-colors duration-150">{{ child.name|e }}</div>
                                                                {% endfor %}
                                                                {% if visible_children|length > 4 %}
                                                                    <div class="text-gray-400 text-xs">+{{ visible_children|length - 4 }} more</div>
                                                                {% endif %}
                                                            </div>
                                                        </div>
                                                        <p class="text-xs text-gray-500 group-hover:opacity-0 transition-opacity duration-200">
                                                            {{ visible_children|length }} {{ visible_children|length == 1 ? trans('filter.subcategory') : trans('filter.subcategories') }}
                                                        </p>
                                                    {% else %}
                                                        <p class="text-xs text-gray-500 group-hover:text-black transition-colors duration-200">{{ trans('album.view_all') }}</p>
                                                    {% endif %}
                                                </div>
                                            </a>
                                        </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tags Dropdown -->
                        {% if show_tags_in_header and nav_tags|default([])|length > 0 %}
                        <div class="relative" id="tags-dropdown">
                            <button id="tags-toggle" class="text-sm font-medium inline-flex items-center gap-2 hover:text-gray-600 transition-all duration-200 py-2 px-1 rounded-md" aria-expanded="false" aria-controls="tags-menu" aria-haspopup="true">
                                {{ trans('nav.tags') }}
                                <i class="fas fa-chevron-down text-xs transition-transform duration-200" id="tags-icon"></i>
                            </button>

                            <!-- Tags Dropdown Panel -->
                            <div id="tags-menu" class="absolute left-0 top-full mt-2 w-64 bg-white border border-gray-200 shadow-xl rounded-xl z-50 overflow-hidden opacity-0 invisible transform translate-y-2 transition-all duration-300 ease-out">
                                <div class="py-3">
                                    {% for tag in nav_tags %}
                                    <a href="{{ base_path }}/tag/{{ tag.slug }}" class="flex items-center justify-between px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-black transition-colors duration-150">
                                        <span class="font-medium">{{ tag.name|e }}</span>
                                        <span class="text-xs text-gray-400">{{ tag.albums_count }}</span>
                                    </a>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                        {% endif %}
                    </nav>
                </div>

                <!-- Right Side Actions -->
                <div class="flex items-center gap-4">
                    {% if is_admin %}
                    <!-- Admin Dashboard Button -->
                    <a href="{{ base_path }}/admin" class="flex items-center gap-2 text-sm font-medium text-white bg-gray-900 hover:bg-gray-700 transition-colors duration-200 py-2 px-4 rounded-md">
                        <i class="fas fa-cog text-xs"></i>
                        <span>Admin</span>
                    </a>
                    {% endif %}

                    <!-- Social Profiles + Search (grouped with tight spacing) -->
                    <div class="flex items-center">
                      {% if social_profiles is defined and social_profiles|length > 0 %}
                      {% for profile in social_profiles %}
                        <a href="{{ profile.url }}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center w-8 h-8 rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-50 transition-colors duration-200" title="{{ profile.name }}" aria-label="{{ profile.name }}">
                          <i class="{{ profile.icon }} text-sm"></i>
                        </a>
                      {% endfor %}
                      {% endif %}
                      <!-- Desktop Search Toggle -->
                      <button id="header-search-toggle" class="hidden md:flex items-center justify-center w-11 h-11 rounded-md hover:bg-gray-50 transition-colors duration-200" aria-label="{{ trans('filter.search') }}" aria-controls="header-search-panel" aria-expanded="false">
                          <i class="fas fa-search text-sm"></i>
                      </button>
                      <!-- Mobile Search Toggle -->
                      <button id="mobile-search-toggle" class="md:hidden flex items-center justify-center w-11 h-11 rounded-md hover:bg-gray-50 transition-colors duration-200" aria-label="{{ trans('filter.search') }}" aria-controls="header-search-panel" aria-expanded="false">
                          <i class="fas fa-search text-sm"></i>
                      </button>
                      <!-- Dark Mode Toggle (admin can disable it to force the site default theme) -->
                      {% if (allow_theme_toggle ?? true) %}
                      {% set _dark_default = dark_mode|default(false) %}
                      <button id="theme-toggle" type="button" class="flex items-center justify-center w-11 h-11 rounded-md hover:bg-gray-50 dark:hover:bg-neutral-800 transition-colors duration-200" aria-label="{{ _dark_default ? trans('theme.toggle_light') : trans('theme.toggle_dark') }}" aria-pressed="{{ _dark_default ? 'true' : 'false' }}">
                          <svg class="{{ _dark_default ? 'hidden' : '' }}" data-theme-icon="dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                          <svg class="{{ _dark_default ? '' : 'hidden' }}" data-theme-icon="light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
                      </button>
                      {% endif %}
                    </div>

                    <!-- Mobile Menu Button - Aligned with Logo -->
                    <button id="mobile-menu-toggle" aria-controls="mobile-menu" aria-expanded="false" aria-label="Menu" class="lg:hidden flex items-center justify-center w-11 h-11 rounded-md hover:bg-gray-50 transition-colors duration-200">
                        <svg class="w-5 h-5 transition-transform duration-200" id="mobile-menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path class="hamburger-line" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                            <path class="close-line hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Search Panel -->
        <div id="header-search-panel" class="border-t border-gray-200 bg-white/95 backdrop-blur-md hidden">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
