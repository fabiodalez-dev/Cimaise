{% extends "frontend/_layout.twig" %}
{% set needs_vendor_scripts = false %}

{% block content %}
{% set nsfw_gate = album.is_nsfw and not is_admin %}
<div class="max-w-md mx-auto px-4 sm:px-6 py-16 sm:py-24 text-center" data-page="album-password">
  <div class="w-16 h-16 rounded-full bg-gray-100 flex items-center justify-center mx-auto mb-6" aria-hidden="true">
    <i class="fas fa-lock text-gray-600 text-2xl"></i>
  </div>
  <h1 class="text-2xl md:text-3xl font-semibold">{{ album.title|e }}</h1>
  <p class="mt-2 text-neutral-600 dark:text-neutral-400">{{ trans('album.password_protected') }}</p>

  {# NSFW + password: a quiet 18+ note instead of an alarm box #}
  {% if nsfw_gate %}
  <div class="mt-6 flex items-start gap-3 text-left rounded-xl border border-gray-200 bg-gray-50 px-4 py-3">
    <span class="shrink-0 mt-0.5 inline-flex items-center rounded-full bg-gray-900 text-white text-[11px] font-semibold tracking-wide px-2 py-0.5">18+</span>
    <p class="text-sm text-neutral-700 leading-relaxed"><span class="font-medium">{{ trans('album.nsfw_title') }}.</span> {{ trans('album.nsfw_password_notice') }}</p>
  </div>
  {% endif %}

  <form id="album-password-form" method="post" action="{{ base_path }}/album/{{ album.slug }}/unlock" class="mt-8 text-left">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <input type="hidden" name="analytics_session_id" id="analytics_session_id" value="">

    {% if error == 'nsfw' %}
    <div id="nsfw-error" role="alert" class="mb-4 flex items-start gap-2.5 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
      <i class="fas fa-exclamation-circle mt-0.5" aria-hidden="true"></i>
      <span>{{ trans('album.nsfw_checkbox') }}</span>
    </div>
    {% elseif error %}
    <div id="password-error" role="alert" class="mb-4 flex items-start gap-2.5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      <i class="fas fa-exclamation-circle mt-0.5" aria-hidden="true"></i>
      <span>{{ trans('album.wrong_password') }}</span>
    </div>
    {% endif %}

    <label for="album-password" class="block text-sm font-medium mb-2">{{ trans('album.enter_password') }}</label>
    <input type="password" id="album-password" name="password" autocomplete="current-password" required autofocus
           {% if error and error != 'nsfw' %}aria-invalid="true" aria-describedby="password-error"{% endif %}
           class="w-full h-12 rounded-lg border border-neutral-300 px-4 bg-white text-neutral-900 dark:bg-neutral-900 dark:text-neutral-200 dark:border-neutral-700">

    {# NSFW age confirmation checkbox for NSFW albums #}
    {% if nsfw_gate %}
    <div class="mt-4">
      <label class="flex items-start gap-3 cursor-pointer py-1">
        <input type="checkbox" name="nsfw_confirmed" id="nsfw_confirmed" required
               class="mt-0.5 h-5 w-5 shrink-0 rounded border-gray-300 text-neutral-900 focus:ring-neutral-900"
               {% if error == 'nsfw' %}aria-describedby="nsfw-error" aria-invalid="true"{% endif %}>
        <span class="text-sm text-gray-700 dark:text-neutral-300 leading-relaxed">{{ trans('album.nsfw_checkbox') }}</span>
      </label>
    </div>
    {% endif %}

    <button type="submit" class="mt-5 w-full h-12 rounded-lg bg-black text-white font-medium hover:bg-neutral-800 dark:bg-white dark:text-black dark:hover:bg-gray-100 transition-colors">{{ trans('general.submit') }}</button>
  </form>

  <a href="{{ base_path }}/galleries" class="mt-8 inline-flex items-center gap-2 py-2 text-sm text-neutral-500 hover:text-black transition-colors">
    <i class="fas fa-arrow-left text-xs" aria-hidden="true"></i>
    {{ trans('nav.galleries') }}
  </a>
</div>
{% endblock %}

{% block scripts %}
<script nonce="{{ csp_nonce() }}">
const sessionIdField = document.getElementById('analytics_session_id');
if (sessionIdField) {
    let sessionId = '';
    try {
        sessionId = sessionStorage.getItem('cimaise_session_id') || '';
    } catch (e) {
        sessionId = '';
    }
    if (sessionId) {
        sessionIdField.value = sessionId;
    }
}

// Save NSFW confirmation to localStorage when form is submitted with checkbox checked
document.getElementById('album-password-form')?.addEventListener('submit', function() {
    var checkbox = document.getElementById('nsfw_confirmed');
    if (checkbox && checkbox.checked) {
        try {
            localStorage.setItem('nsfw_confirmed', 'true');
        } catch (e) {}
    }
});
</script>
{% endblock %}
