{% if (home_settings.hero_show_title ?? true) or (home_settings.hero_show_text ?? true) %}
<div class="text-center py-12 md:py-20">
  {% if home_settings.hero_show_title ?? true %}
    <h1 class="text-4xl md:text-6xl font-light text-black mb-6">{{ home_settings.hero_title|default('Portfolio')|e }}</h1>
  {% endif %}
  {% if home_settings.hero_show_text ?? true %}
    <p class="text-lg md:text-xl text-neutral-600 max-w-2xl mx-auto leading-relaxed">{{ home_settings.hero_subtitle|default('A collection of analog and digital photography exploring light, form, and the beauty of everyday moments.')|e }}</p>
  {% endif %}
</div>
{% endif %}
