{# WebSite JSON-LD + SearchAction — shared by all home templates.
   The SearchAction target is ABSOLUTE (via canonical_base) and uses the real
   ?search= query parameter the search endpoint reads. #}
{% set _cb = canonical_base|default('') %}
{% set _gslug = galleries_slug|default('galleries') %}
{% set search_url_template = _cb
    ? (_cb ~ '/' ~ _gslug ~ '?search={search_term_string}')
    : (base_path ~ '/' ~ _gslug ~ '?search={search_term_string}') %}
<script type="application/ld+json" nonce="{{ csp_nonce() }}">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ site_title|default('Portfolio')|json_encode|raw }},
  "url": {{ (canonical_url|default(current_url))|json_encode|raw }},
  {% if meta_description %}"description": {{ meta_description|json_encode|raw }},{% endif %}
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": {{ search_url_template|json_encode|raw }}
    },
    "query-input": "required name=search_term_string"
  }
}
</script>
