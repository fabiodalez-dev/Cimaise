{% extends "admin/_layout.twig" %}

{% block title %}{{ trans('admin.diagnostics.title') }} — Cimaise{% endblock %}

{% block content %}
<div class="max-w-6xl mx-auto">

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mb-8">
        <h1 class="text-2xl font-semibold text-gray-900">{{ trans('admin.diagnostics.title') }}</h1>
        <button data-action="reload-page" class="btn-primary">
            {{ trans('admin.diagnostics.refresh') }}
        </button>
    </div>

    <div class="card">
        {% for key, diagnostic in diagnostics %}
        {% set tone = diagnostic.status == 'ok' ? 'bg-green-100 text-green-800'
                    : (diagnostic.status == 'warning' ? 'bg-yellow-100 text-yellow-800'
                    : (diagnostic.status == 'error' ? 'bg-red-100 text-red-800' : 'bg-accent-100 text-accent-800')) %}
        {% set icon = diagnostic.status == 'ok' ? 'fa-check-circle'
                    : (diagnostic.status == 'warning' ? 'fa-exclamation-triangle'
                    : (diagnostic.status == 'error' ? 'fa-times-circle' : 'fa-info-circle')) %}
        <div class="flex flex-col sm:flex-row sm:items-start gap-2 sm:gap-6 px-5 py-4 border-b border-gray-200 last:border-b-0">
            <h3 class="sm:w-56 shrink-0 text-sm font-semibold text-gray-900 sm:pt-0.5">{{ diagnostic.name }}</h3>
            <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                    <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium {{ tone }}">
                        <i class="fas {{ icon }}" aria-hidden="true"></i>
                        {{ diagnostic.value }}
                    </span>
                    <span class="text-sm text-gray-600">{{ diagnostic.message }}</span>
                </div>
                {% if diagnostic.details %}
                <dl class="mt-2 grid gap-x-6 gap-y-1 sm:grid-cols-2 text-xs">
                    {% for key, value in diagnostic.details %}
                    <div class="flex justify-between gap-3 min-w-0">
                        <dt class="text-gray-500 shrink-0">{{ key }}</dt>
                        <dd class="text-gray-900 font-mono text-right break-all min-w-0">{{ value }}</dd>
                    </div>
                    {% endfor %}
                </dl>
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </div>

    <div class="mt-8 bg-accent-50 border border-accent-200 rounded-lg p-6">
        <h3 class="text-lg font-medium text-accent-900 mb-2">{{ trans('admin.diagnostics.system_requirements') }}</h3>
        <p class="text-accent-800 text-sm mb-4">
            {{ trans('admin.diagnostics.requirements_hint') }}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
            <div>
                <h4 class="font-medium text-accent-900 mb-2">{{ trans('admin.diagnostics.minimum_requirements') }}</h4>
                <ul class="text-accent-800 space-y-1">
                    <li>• PHP 8.2+</li>
                    <li>• MySQL 8.0+ / MariaDB 10.6+</li>
                    <li>• 128MB memory limit</li>
                    <li>• {{ trans('admin.diagnostics.extensions') }}: PDO, pdo_mysql, mbstring, json, fileinfo</li>
                </ul>
            </div>

            <div>
                <h4 class="font-medium text-accent-900 mb-2">{{ trans('admin.diagnostics.recommended') }}</h4>
                <ul class="text-accent-800 space-y-1">
                    <li>• 256MB+ memory limit</li>
                    <li>• GD / ImageMagick</li>
                    <li>• EXIF</li>
                    <li>• {{ trans('admin.diagnostics.writable_dirs') }}</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="mt-8 bg-gray-50 border border-gray-200 rounded-lg p-6">
        <h3 class="text-lg font-medium text-gray-900 mb-2">{{ trans('admin.diagnostics.cli_commands') }}</h3>
        <p class="text-gray-600 text-sm mb-4">
            {{ trans('admin.diagnostics.cli_commands_hint') }}
        </p>

        <div class="bg-gray-900 text-green-400 p-4 rounded font-mono text-sm space-y-2 overflow-x-auto">
            <div># {{ trans('admin.diagnostics.generate_variants') }}</div>
            <div>php bin/console images:generate --missing</div>
            <div></div>
            <div># {{ trans('admin.diagnostics.build_sitemap') }}</div>
            <div>php bin/console sitemap:build --base-url https://yourdomain.com</div>
            <div></div>
            <div># {{ trans('admin.diagnostics.run_diagnostics') }}</div>
            <div>php bin/console diagnostics</div>
            <div></div>
            <div># {{ trans('admin.diagnostics.create_admin') }}</div>
            <div>php bin/console user:create admin@example.com</div>
        </div>
    </div>

</div>
{% endblock %}

{% block scripts %}
<script nonce="{{ csp_nonce() }}">
(function initDiagnosticsPage() {
  document.querySelectorAll('[data-action="reload-page"]').forEach(btn => {
    if (btn._bound) return;
    btn._bound = true;
    btn.addEventListener('click', () => location.reload());
  });
})();
</script>
{% endblock %}
