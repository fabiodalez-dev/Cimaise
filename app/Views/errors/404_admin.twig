{% extends 'admin/_layout.twig' %}
{% block title %}404 — {{ trans('errors.404.title') }}{% endblock %}
{% block content %}
<div class="flex items-center justify-center min-h-[60vh]">
    <div class="text-center">
        <p class="font-serif text-8xl text-gray-200 leading-none select-none" aria-hidden="true">404</p>
        <h1 class="text-2xl text-gray-800 mt-4 mb-2">{{ trans('errors.404.title') }}</h1>
        <p class="text-gray-600 mb-6">{{ trans('errors.404.message') }}</p>
        <a href="{{ base_path }}/admin" class="btn-primary">
